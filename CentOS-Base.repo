# /etc/yum.repos.d/CentOS-Base.repo

[base]
name=CentOS-$releasever - Base
mirrorlisthttp://mirror.nsc.liu.se/centos-store/7.0.1406/os/x86_64/
baseurl=https://mirror.nsc.liu.se/centos-store/centos/$releasever/os/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7

#released updates 
[updates]
name=CentOS-$releasever - Updates
mirrorlist=http://mirror.nsc.liu.se/centos-store/7.0.1406/updates/x86_64/
baseurl=https://mirror.nsc.liu.se/centos-store/centos/$releasever/updates/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7

#additional packages that may be useful
[extras]
name=CentOS-$releasever - Extras
mirrorlist=http://mirror.nsc.liu.se/centos-store/7.0.1406/updates/x86_64/
baseurl=https://mirror.nsc.liu.se/centos-store/centos/$releasever/extras/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7

#additional packages that extend functionality of existing packages
[centosplus]
name=CentOS-$releasever - Plus
mirrorlis=http://mirror.nsc.liu.se/centos-store/7.0.1406/centosplus/x86_64/
baseurl=https://mirror.nsc.liu.se/centos-store/centos/$releasever/centosplus/$basearch/
gpgcheck=1
enabled=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
